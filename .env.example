# FAIRRATE Environment Variables Template
# Copy this file to .env and populate with your local values.

# ── API & Server Configuration ──
PORT=8000
VITE_API_URL=http://localhost:8000

# ── Security & CORS ──
# Comma-separated list of permitted origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── AI Services (Optional) ──
# Anthropic API Key for advanced loan offer parsing and negotiation letter drafting
# If not provided, FAIRRATE seamlessly falls back to rule-based heuristics and local OCR
ANTHROPIC_API_KEY=

# ── Rate Limiting ──
# Default request limits via slowapi
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_TOOLS=20/minute
